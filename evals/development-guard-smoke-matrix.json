{
  "schema_version": 2,
  "run_kind": "development-smoke",
  "matrix_id": "development-guard-smoke",
  "version": 2,
  "description": "Development-only three-call guarded smoke on a previously used regression fixture. This run validates extension loading, submit evidence, parsing, deterministic scoring, resume, bounded provider concurrency, and provider-reported cost capture. It is not release evidence.",
  "amendments": [
    {
      "version": 1,
      "reason": "Initial development smoke plan before the first schema-v2 release-candidate run."
    },
    {
      "version": 2,
      "reason": "Rerun after runner version 6 added exact accepted tool-result handling for Pi JSON print mode. The first smoke retained three terminal failures and produced no release-candidate evidence."
    }
  ],
  "scenario_ids": ["release-facts-and-causes"],
  "conditions": ["baseline", "native-skill", "guarded"],
  "conditions_by_scenario": {
    "release-facts-and-causes": ["guarded"]
  },
  "models": [
    {
      "provider": "openai-codex",
      "model": "gpt-5.6-sol",
      "thinking": "high"
    },
    {
      "provider": "github-copilot",
      "model": "claude-sonnet-5",
      "thinking": "low"
    },
    {
      "provider": "github-copilot",
      "model": "gemini-3.6-flash",
      "thinking": "medium"
    }
  ],
  "repetitions": 1,
  "retry_limit": 2,
  "timeout_seconds": 300,
  "inter_call_delay_seconds": 0,
  "max_parallel_calls": 3,
  "max_parallel_calls_by_provider": {
    "openai-codex": 1,
    "github-copilot": 2
  },
  "system_prompt": "Return only the final output requested by the user. Do not include analysis, rule commentary, or a preface.",
  "semantic_gate_conditions": ["guarded"],
  "acceptance_thresholds": {
    "applicable_cell_completeness": 1.0,
    "model_identity": 1.0,
    "routing_safety": 1.0,
    "semantic": 1.0,
    "procedure": 1.0,
    "output_contract": 1.0,
    "guard_integrity": 1.0,
    "positive_activation_minimum_fraction": {
      "numerator": 2,
      "denominator": 3
    },
    "negative_activation_maximum_loaded": 0,
    "activation_applicable": false
  },
  "isolation": {
    "tools_by_condition": {
      "baseline": [],
      "native-skill": ["read"],
      "guarded": []
    },
    "extensions": false,
    "skills": "explicit-only",
    "prompt_templates": false,
    "themes": false,
    "context_files": false,
    "session_persistence": false,
    "project_trust": false,
    "startup_network": false
  },
  "output_contract": {
    "type": "text",
    "forbidden_patterns": [
      "(?is)^\\s*here(?:'s| is| are)\\b",
      "(?is)^\\s*(?:rewritten|revised) (?:text|version)\\s*:"
    ]
  },
  "corpus_path": "fixtures/semantic-preservation.json",
  "benchmark_scenarios_path": "benchmark-scenarios.json",
  "evidence_policy": {
    "development_only": true,
    "must_not_count_as_release_evidence": true,
    "must_complete_before_release_candidate_generation": true
  }
}
