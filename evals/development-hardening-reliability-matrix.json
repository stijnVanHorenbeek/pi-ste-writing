{
  "schema_version": 3,
  "run_kind": "development-probe",
  "matrix_id": "development-hardening-reliability",
  "version": 1,
  "description": "Development-only reliability probe for retained guard and routing regressions.",
  "amendments": [
    {
      "version": 1,
      "reason": "Exercise known guarded duplicate-draft and native failed-read regressions after generic hardening."
    }
  ],
  "scenario_ids": [
    "hyperion-refuel-sequence",
    "nexus-protocol-state"
  ],
  "conditions": [
    "baseline",
    "native-skill",
    "guarded"
  ],
  "conditions_by_scenario": {
    "hyperion-refuel-sequence": [
      "guarded"
    ],
    "nexus-protocol-state": [
      "native-skill"
    ]
  },
  "models": [
    {
      "provider": "openai-codex",
      "model": "gpt-5.6-sol",
      "thinking": "high"
    },
    {
      "provider": "github-copilot",
      "model": "claude-sonnet-5",
      "thinking": "low"
    },
    {
      "provider": "github-copilot",
      "model": "gemini-3.6-flash",
      "thinking": "medium"
    }
  ],
  "repetitions": 3,
  "retry_limit": 2,
  "timeout_seconds": 300,
  "inter_call_delay_seconds": 2,
  "max_parallel_calls": 3,
  "max_parallel_calls_by_provider": {
    "openai-codex": 1,
    "github-copilot": 2
  },
  "system_prompt": "Return only the final output requested by the user. Do not include analysis, rule commentary, or a preface.",
  "acceptance_thresholds": {
    "applicable_cell_completeness": 1.0,
    "model_identity": 1.0,
    "routing_safety": 1.0,
    "output_contract": 1.0,
    "guard_integrity": 1.0,
    "positive_activation_minimum_fraction": {
      "numerator": 2,
      "denominator": 3
    },
    "negative_activation_maximum_loaded": 0,
    "activation_applicable": false,
    "objective_contract": 1.0,
    "objective_procedure": 1.0
  },
  "isolation": {
    "tools_by_condition": {
      "baseline": [],
      "native-skill": [
        "read"
      ],
      "guarded": []
    },
    "extensions": false,
    "skills": "explicit-only",
    "prompt_templates": false,
    "themes": false,
    "context_files": false,
    "session_persistence": false,
    "project_trust": false,
    "startup_network": false
  },
  "output_contract": {
    "type": "text",
    "forbidden_patterns": [
      "(?is)^\\s*here(?:'s| is| are)\\b",
      "(?is)^\\s*(?:rewritten|revised) (?:text|version)\\s*:"
    ]
  },
  "corpus_path": "fixtures/semantic-boundary-release-candidate.json",
  "benchmark_scenarios_path": "semantic-boundary-release-candidate-scenarios.json",
  "evidence_policy": {
    "development_only": true,
    "must_not_count_as_release_evidence": true,
    "frozen_release_evidence_must_not_change": true,
    "new_held_out_work_blocked_until_probe_review": true
  },
  "objective_gate_conditions": [
    "native-skill",
    "guarded"
  ],
  "acceptance_model": "hybrid-semantic-v1",
  "semantic_review": {
    "config_path": null,
    "applicability_field": "semantic_review_applicable",
    "gated_conditions": [
      "native-skill",
      "guarded"
    ],
    "required_unique_candidate_coverage": 1.0,
    "accepted_label": "equivalent",
    "adverse_labels": [
      "not_equivalent",
      "uncertain"
    ],
    "conflict_policy": "fail",
    "manual_override": false
  }
}
