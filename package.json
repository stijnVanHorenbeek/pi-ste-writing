    "docs",
    "extensions",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typebox": "^1.3.12",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions/writing-advisor.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
