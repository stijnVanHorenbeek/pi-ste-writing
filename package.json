{
  "name": "pi-ste-writing",
  "version": "0.1.0",
  "type": "module",
  "description": "Clear technical writing skill for Pi that rewrites documentation, READMEs, and runbooks while preserving technical meaning",
  "keywords": [
    "pi-package",
    "pi-skill",
    "pi-extension",
    "clear-technical-writing",
    "technical-writing",
    "technical-documentation",
    "documentation",
    "readme",
    "runbook",
    "asd-ste100",
    "simplified-technical-english"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stijnVanHorenbeek/pi-ste-writing.git"
  },
  "bugs": {
    "url": "https://github.com/stijnVanHorenbeek/pi-ste-writing/issues"
  },
  "homepage": "https://github.com/stijnVanHorenbeek/pi-ste-writing#readme",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
